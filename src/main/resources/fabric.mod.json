{
	"schemaVersion": 1,
	"id": "btashaders",
	"version": "${version}",
	"name": "BTA Shaders",
	"description": "Warm, sunny shaders for Better than Adventure! 8.0.1: soft sun shadows, light shafts, volumetric clouds, water and rain reflections, colored glass shadows, labPBR support. Settings: Mod Menu or Shift+F7.",
	"authors": [
		"mtureyen"
	],
	"contact": {
		"homepage": "https://github.com/mtureyen/bta-shaders-v8-0-1",
		"sources": "https://github.com/mtureyen/bta-shaders-v8-0-1"
	},
	"icon": "icon.png",
	"license": "GPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.mtureyen.btashaders.BtaShaders"
		],
		"modmenu": [
			"io.github.mtureyen.btashaders.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"btashaders.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
